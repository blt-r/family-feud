{
  "name": "family-feud",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev --host 0.0.0.0 --port 8787",
    "build": "vite build",
    "preview": "pnpm run build && vite preview --host 0.0.0.0 --port 8787",
    "deploy": "pnpm run build && wrangler deploy",
    "check": "svelte-check --tsconfig ./jsconfig.json && node --check src/worker.js",
    "test": "node --test"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "svelte": "^5.56.10",
    "svelte-check": "^4.7.6",
    "vite": "^8.2.2",
    "wrangler": "^4.33.1"
  }
}
