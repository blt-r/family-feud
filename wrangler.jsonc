{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "family-feud",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-27",
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "GAME_ROOMS",
        "class_name": "GameRoom"
      },
      {
        "name": "ROOM_CREATION_LIMITER",
        "class_name": "RoomCreationLimiter"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["GameRoom"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["RoomCreationLimiter"]
    }
  ]
}
